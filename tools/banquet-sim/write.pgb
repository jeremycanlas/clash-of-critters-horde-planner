\set u random(4, 200)
\set i random(1, 900)
\set uid (case when :u <= 83 then 20000000 when :u <= 143 then 30000000 else 50000000 end) + :i
select set_config('request.jwt.claims', '{"sub":"00000000-0000-4000-8000-' || lpad(:u::text, 12, '0') || '","role":"authenticated"}', false);
set role authenticated;
select public.banquet_claim(:uid, true);
select public.banquet_mark(:uid, 'open');
reset role;
